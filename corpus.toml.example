# corpus.toml — instance config.
#
# Copy this file to `corpus.toml` and edit. The real config is gitignored
# so you can keep paths/keys/etc out of source control.

[corpus]
# Where the chunks + vectors live. SQLite + sqlite-vec; one file.
db_path = "./corpus.db"

[embedder]
# Built-in providers: voyage, gemini.
#
# voyage (voyage-4-large, 1024-dim) is the default — top retrieval quality,
# Anthropic-recommended. Card-on-file required to lift free-tier rate limits.
#
# gemini (gemini-embedding-001) is the alternative — no card needed, free tier
# via Google AI Studio. Matryoshka dim selection: 768, 1536, or 3072.
#
# The dim MUST match the model's output. The DB stores it on first ingest
# and refuses to open with a mismatched dim (rather than silently corrupt).
provider = "voyage"
model = "voyage-4-large"
dim = 1024

[retriever]
# Defaults you almost never need to touch.
top_k = 5
max_per_source_type = 3   # cross-source diversity in result list
hybrid = true              # combine vector + BM25 via reciprocal rank fusion

[reranker]
# Settings for the optional local BGE cross-encoder re-ranker (opt in per
# query/eval run via --rerank; install with `pip install corpus-rag[reranker]`).
#
# device: "cpu" (default) or "mps" (Apple Silicon GPU) or any torch device
# string. Defaults to CPU deliberately, not to auto-detection — on Apple
# Silicon, letting sentence-transformers pick silently lands on MPS, and
# corpus has no way to know whether something else (e.g. a long-running MLX
# job) already has the GPU, and CPU can never contend with another process's
# GPU work. Measured on an M4 Pro: ~10-12s to rerank a 30-candidate pool on
# CPU vs. ~4-5s on MPS (~2.7x faster) — neither is sub-second, so budget for
# this latency either way. Set to "mps" only if you know the GPU is free and
# want the speedup.
device = "cpu"

[pruning]
# Guards orphan deletion during ingest against a connector that silently
# under-yields documents while still honestly reporting zero failures (a real
# incident: a connector that skipped files it believed were unchanged, then on
# a later run matched almost nothing and would have deleted the whole source's
# index -- `failed_files` never saw it, because the connector wasn't reporting
# any failure). `corpus-ingest` refuses to prune a source when the chunks about
# to be deleted exceed max_orphan_ratio of that source's existing chunk count,
# UNLESS the source has fewer than min_chunks_for_guard chunks to begin with
# (a small/new source can cross 20% on a handful of genuine deletions, and the
# blast radius is too small to matter). `corpus-ingest --source NAME
# --prune-anyway` bypasses this deliberately, for a real bulk deletion.
max_orphan_ratio = 0.20
min_chunks_for_guard = 50

# Each source = one place to read documents from.
# `name` is a free-form label used everywhere as the chunk's source_type.
# `type` selects which built-in connector to use.
#
# Built-in connectors as of v0.1:
#   markdown — `.md` files with optional YAML frontmatter (default glob: **/*.md)
#   text     — `.txt` plain text files (default glob: **/*.txt)
#   pdf      — PDFs via pypdf; install: `pip install corpus-rag[pdf]`
#   html     — HTML files via trafilatura; install: `pip install corpus-rag[html]`
#   docx     — Word documents via python-docx; install: `pip install corpus-rag[docx]`
#   xlsx     — Excel workbooks via openpyxl; install: `pip install corpus-rag[xlsx]`
#   rtf      — Rich Text Format via striprtf; install: `pip install corpus-rag[rtf]`
#
# Adding a new source type? See docs/adding_a_source.md.

[[sources]]
name = "notes"
type = "markdown"
path = "~/Documents/notes"
# glob = "**/*.md"  # optional; defaults to the connector's default

# [[sources]]
# name = "papers"
# type = "pdf"
# path = "~/Documents/papers"
# glob = "**/*.pdf"

# [[sources]]
# name = "bookmarks"
# type = "html"
# path = "~/exports/saved-articles"

# [[sources]]
# name = "plain_notes"
# type = "text"
# path = "~/Documents/quick-notes"

# [[sources]]
# name = "word_docs"
# type = "docx"
# path = "~/Documents"

# [[sources]]
# name = "spreadsheets"
# type = "xlsx"
# path = "~/Documents"

# [[sources]]
# name = "rtf_notes"
# type = "rtf"
# path = "~/Documents"

# Reference patterns that `expand_context` will look for inside a chunk's
# content, plus that auto-tune BM25 weight when the user's query contains them.
# Default: empty. If empty, `expand_context` returns siblings + parent only
# (no cross-document reference chasing).
#
# Example below shows Jira-style keys. Adapt to your archive — could be
# DOI numbers, RFC references, GitHub issues, internal ticket IDs, etc.
#
# [[references]]
# pattern = '\b[A-Z]{2,}-\d+\b'
# source_type = "tickets"
# description = "Jira-style keys (PROJ-123)"
