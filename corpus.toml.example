# corpus.toml — instance config.
#
# Copy this file to `corpus.toml` and edit. The real config is gitignored
# so you can keep paths/keys/etc out of source control.

[corpus]
# Where the chunks + vectors live. SQLite + sqlite-vec; one file.
db_path = "./corpus.db"

[embedder]
# Built-in providers: voyage, gemini.
#
# voyage (voyage-4-large, 1024-dim) is the default — top retrieval quality,
# Anthropic-recommended. Card-on-file required to lift free-tier rate limits.
#
# gemini (gemini-embedding-001) is the alternative — no card needed, free tier
# via Google AI Studio. Matryoshka dim selection: 768, 1536, or 3072.
#
# The dim MUST match the model's output. The DB stores it on first ingest
# and refuses to open with a mismatched dim (rather than silently corrupt).
provider = "voyage"
model = "voyage-4-large"
dim = 1024

[retriever]
# Defaults you almost never need to touch.
top_k = 5
max_per_source_type = 3   # cross-source diversity in result list
hybrid = true              # combine vector + BM25 via reciprocal rank fusion

[reranker]
# Settings for the optional local BGE cross-encoder re-ranker (opt in per
# query/eval run via --rerank; install with `pip install corpus-rag[reranker]`).
#
# device: "cpu" (default) or "mps" (Apple Silicon GPU) or any torch device
# string. Defaults to CPU deliberately, not to auto-detection — on Apple
# Silicon, letting sentence-transformers pick silently lands on MPS, and
# corpus has no way to know whether something else (e.g. a long-running MLX
# job) already has the GPU, and CPU can never contend with another process's
# GPU work. Measured on an M4 Pro: ~10-12s to rerank a 30-candidate pool on
# CPU vs. ~4-5s on MPS (~2.7x faster) — neither is sub-second, so budget for
# this latency either way. Set to "mps" only if you know the GPU is free and
# want the speedup.
device = "cpu"

[pruning]
# Guards orphan deletion during ingest against a connector that silently
# under-yields documents while still honestly reporting zero failures (a real
# incident: a connector that skipped files it believed were unchanged, then on
# a later run matched almost nothing and would have deleted the whole source's
# index -- `failed_files` never saw it, because the connector wasn't reporting
# any failure). `corpus-ingest` refuses to prune a source when the chunks about
# to be deleted exceed max_orphan_ratio of that source's existing chunk count,
# UNLESS the source has fewer than min_chunks_for_guard chunks to begin with
# (a small/new source can cross 20% on a handful of genuine deletions, and the
# blast radius is too small to matter). `corpus-ingest --source NAME
# --prune-anyway` bypasses this deliberately, for a real bulk deletion.
max_orphan_ratio = 0.20
min_chunks_for_guard = 50

[performance]
# SQLite memory-tuning pragmas. Isolated each one individually on a
# synthetic 150k-chunk/711MB store before picking these defaults, rather
# than bundling all three on the assumption they all help equally:
#
#   mmap_size_mb       -- THE knob that matters. sqlite-vec's vector index
#                          does an exhaustive scan per search (no ANN index),
#                          so memory-mapped I/O -- turning each page touch
#                          into a direct memory read instead of a read()
#                          syscall + copy -- helps every query, uniformly.
#                          Measured 3.18x-3.29x on vector search once the
#                          window covered the whole store; only 1.37x
#                          covering about a third of it. Must cover your
#                          store's actual file size to get most of the
#                          benefit -- raise this if your corpus.db is
#                          bigger than the default 1GiB. Safe to set large:
#                          it's a ceiling on a lazily-paged-in, evictable
#                          mapping, not a memory reservation, and a store
#                          bigger than the ceiling just falls back to
#                          ordinary I/O for the excess rather than erroring.
#   cache_size_mb       -- Measured NO effect on vector search (confirmed
#                          twice: cold connections, and a single persistent
#                          connection re-running the same queries six times
#                          in a row -- nothing to cache helps a query that
#                          touches ~everything anyway). Kept modest as a
#                          safety net for other access patterns this
#                          benchmark didn't cover (point lookups during
#                          ingest dedup, get_by_id, etc.) which do have
#                          real locality. Unlike mmap_size, this memory IS
#                          a real allocation, so it stays conservative
#                          (tens of MB) rather than scaling with your RAM.
#   temp_store_memory   -- Also measured no effect (EXPLAIN QUERY PLAN
#                          confirms vector search's ORDER BY does use a
#                          temp b-tree, but it only sorts the ~top_k result
#                          rows -- trivially cheap either way at that
#                          size). Left on: free today, margin against a
#                          future query shape that sorts more.
#
# Full methodology + raw numbers in the corpus-hardening project notes.
# Defaults are fixed, not scaled off detected RAM -- no portable stdlib way
# to read total physical memory (no os.sysconf on Windows), and corpus
# keeps its base install dependency-minimal by design. Raise mmap_size_mb
# if `corpus-list` shows your corpus.db bigger than the current setting.
cache_size_mb = 64
mmap_size_mb = 1024
temp_store_memory = true

# Each source = one place to read documents from.
# `name` is a free-form label used everywhere as the chunk's source_type.
# `type` selects which built-in connector to use.
#
# Built-in connectors as of v0.1:
#   markdown — `.md` files with optional YAML frontmatter (default glob: **/*.md)
#   text     — `.txt` plain text files (default glob: **/*.txt)
#   pdf      — PDFs via pypdf; install: `pip install corpus-rag[pdf]`
#   html     — HTML files via trafilatura; install: `pip install corpus-rag[html]`
#   docx     — Word documents via python-docx; install: `pip install corpus-rag[docx]`
#   xlsx     — Excel workbooks via openpyxl; install: `pip install corpus-rag[xlsx]`
#   rtf      — Rich Text Format via striprtf; install: `pip install corpus-rag[rtf]`
#   pptx     — PowerPoint decks via python-pptx; install: `pip install corpus-rag[pptx]`.
#              Slide text AND speaker notes, one section per slide. Legacy binary
#              `.ppt` is a different container format entirely and is skipped, not
#              retried, if one is ever found under a `.pptx` glob.
#   csv      — CSV files (default glob: **/*.csv); no extra needed (stdlib csv).
#              Deliberately does NOT index every row — see src/corpus/connectors/csv_.py's
#              module docstring for the full reasoning. Small files (<=100 rows, <=50k
#              chars) are indexed in full; larger files get filename + inferred
#              column names/types + a fixed 20-row head/tail sample, so a 50,000-row
#              export doesn't drown the rest of the index in near-duplicate row chunks.
#   tsv      — Same connector as csv, tab-delimited default (default glob: **/*.tsv);
#              the delimiter is actually auto-detected per file either way.
#   zip      — `.zip` archives (default glob: **/*.zip); extracts to a temp dir,
#              re-runs the connectors above by file type found inside, then
#              deletes the extracted copies. The archive itself is never
#              modified. No extra needed (stdlib zipfile) unless the archive
#              contents need one (e.g. a zip full of PDFs still needs [pdf]).
#              By default it also skips vendored-dependency/build-output
#              members (node_modules, site-packages, .git, dist/build/target
#              when corroborated by a matching manifest, *.min.js, *.map,
#              ...) so a deployment bundle's node_modules READMEs don't get
#              indexed as if they were your own notes. Set
#              `exclude_dependencies = false` on a [[sources]] block below to
#              turn this off and index vendored docs on purpose.
#
# Adding a new source type? See docs/adding_a_source.md.

[[sources]]
name = "notes"
type = "markdown"
path = "~/Documents/notes"
# glob = "**/*.md"  # optional; defaults to the connector's default

# [[sources]]
# name = "papers"
# type = "pdf"
# path = "~/Documents/papers"
# glob = "**/*.pdf"

# [[sources]]
# name = "bookmarks"
# type = "html"
# path = "~/exports/saved-articles"

# [[sources]]
# name = "plain_notes"
# type = "text"
# path = "~/Documents/quick-notes"

# [[sources]]
# name = "word_docs"
# type = "docx"
# path = "~/Documents"

# [[sources]]
# name = "spreadsheets"
# type = "xlsx"
# path = "~/Documents"

# [[sources]]
# name = "rtf_notes"
# type = "rtf"
# path = "~/Documents"

# [[sources]]
# name = "presentations"
# type = "pptx"
# path = "~/Documents"

# [[sources]]
# name = "spreadsheet_exports"
# type = "csv"
# path = "~/Documents/exports"

# [[sources]]
# name = "tab_separated_exports"
# type = "tsv"
# path = "~/Documents/exports"

# [[sources]]
# name = "archives"
# type = "zip"
# path = "~/Documents/zipped-reports"
# exclude_dependencies = true  # optional; default true, see the zip note above

# Reference patterns that `expand_context` will look for inside a chunk's
# content, plus that auto-tune BM25 weight when the user's query contains them.
# Default: empty. If empty, `expand_context` returns siblings + parent only
# (no cross-document reference chasing).
#
# Example below shows Jira-style keys. Adapt to your archive — could be
# DOI numbers, RFC references, GitHub issues, internal ticket IDs, etc.
#
# [[references]]
# pattern = '\b[A-Z]{2,}-\d+\b'
# source_type = "tickets"
# description = "Jira-style keys (PROJ-123)"
