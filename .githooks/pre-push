#!/bin/sh
# Refuse to PUSH commits whose messages name a private project.
#
# WHY HERE AND NOT IN CI. The obvious home for this is a CI job, and that
# cannot work: the patterns live in .git/private-name-patterns, which is
# untracked BY DESIGN so a denylist of private names never reaches the public
# remote. CI has no .git/ of yours and so has nothing to match against. Putting
# the names in a repo secret would defeat the point -- it uploads them to the
# very service the rule exists to keep them off.
#
# So the last useful moment is here, locally, immediately before the data
# leaves the machine.
#
# WHAT THIS ADDS OVER commit-msg. That hook stops a bad message being written.
# This one scans every commit actually being PUSHED, which catches the cases
# it cannot: commits made with --no-verify, commits authored before the hook
# existed, and history pulled in from elsewhere. The leak this project had was
# exactly that shape -- a commit from before any guard existed, carried into a
# fresh repository by a re-push.
#
# AND WHY GETTING IT RIGHT HERE MATTERS MORE THAN LATER: a force-push does not
# undo it. GitHub keeps unreachable objects and serves them by SHA; only
# GitHub Support can purge them.

PATTERNS="$(git rev-parse --git-dir)/private-name-patterns"

if [ ! -f "$PATTERNS" ]; then
    echo "" >&2
    echo "  NOTE: $PATTERNS is missing, so pushed commit messages are NOT" >&2
    echo "  being checked for private names. It is untracked on purpose --" >&2
    echo "  recreate it after a fresh clone. One regex per line." >&2
    echo "" >&2
    exit 0
fi

# Positive control: prove grep can match at all. A broken or missing grep
# would otherwise report every history clean, forever.
if ! printf 'canary\n' | grep -qiE 'canary'; then
    echo "" >&2
    echo "  PUSH BLOCKED: grep did not match a string that must match, so" >&2
    echo "  the private-name check cannot be trusted on this machine." >&2
    echo "" >&2
    exit 1
fi

# Strip comments and blanks into a plain pattern file grep can read.
ACTIVE="$(mktemp)" || {
    echo "" >&2
    echo "  PUSH BLOCKED: could not create a temporary file, so the" >&2
    echo "  private-name check cannot run." >&2
    echo "" >&2
    exit 1
}
trap 'rm -f "$ACTIVE"' EXIT

# READABLE, not merely present. An unreadable pattern file made both greps
# exit 2, left ACTIVE empty, and fell through to the `exit 0` below -- so
# "I could not read the rules" and "the rules are all comments" produced the
# same silent pass. Only the second is a reason to allow a push.
if [ ! -r "$PATTERNS" ]; then
    echo "" >&2
    echo "  PUSH BLOCKED: $PATTERNS exists but cannot be read, so NO" >&2
    echo "  private-name pattern is being checked." >&2
    echo "" >&2
    exit 1
fi
grep -v '^[[:space:]]*#' "$PATTERNS" | grep -v '^[[:space:]]*$' > "$ACTIVE"
[ -s "$ACTIVE" ] || exit 0

# `grep` exits 0 on a match, 1 on no match, and 2 ON AN ERROR. The `if` below
# used to treat 1 and 2 alike, so an invalid regex read as "clean" and the
# push went through. With -f PATTERNFILE one bad line fails the WHOLE file,
# so a single typo disabled every pattern at once.
#
# Compiled here against empty input, before any commit is examined: a valid
# pattern file exits 1 (no match), a broken one exits 2. Fail CLOSED -- the
# operator must not be left believing a denylist with a hole in it covers
# them.
printf '' | grep -qiEf "$ACTIVE" 2>/dev/null
if [ "$?" -ge 2 ]; then
    echo "" >&2
    echo "  ################################################################" >&2
    echo "  #         PUSH BLOCKED: a private-name pattern is broken       #" >&2
    echo "  ################################################################" >&2
    echo "" >&2
    echo "  $PATTERNS" >&2
    echo "  contains a line that is not a valid POSIX extended regular" >&2
    echo "  expression. grep rejects the whole file, so NO pattern is being" >&2
    echo "  checked -- not the broken one, and not the others." >&2
    echo "" >&2
    echo "  (The patterns are not printed here -- a pattern IS a private" >&2
    echo "   name.) Run this to see which line grep rejects:" >&2
    echo "" >&2
    echo "    printf '' | grep -qiEf \"\$(git rev-parse --git-dir)/private-name-patterns\"" >&2
    echo "" >&2
    exit 1
fi

FOUND=0
while read -r local_ref local_sha _remote_ref remote_sha; do
    # THE REF NAME ITSELF. Branches and tags are published as refs and shown
    # in the remote's UI; neither the message scan nor the diff scan looks at
    # them, so `git push origin <private-name>-experiment` disclosed it with
    # every guard reporting clean.
    printf '%s\n' "$local_ref" | grep -qiEf "$ACTIVE"
    RC=$?
    if [ "$RC" -ge 2 ]; then
        echo "" >&2
        echo "  PUSH BLOCKED: the private-name scan errored on a ref name," >&2
        echo "  so this push was NOT checked." >&2
        exit 1
    fi
    if [ "$RC" -eq 0 ]; then
        echo "" >&2
        echo "  ################################################################" >&2
        echo "  #            PUSH BLOCKED: private name in a REF name          #" >&2
        echo "  ################################################################" >&2
        echo "" >&2
        echo "  The branch or tag being pushed names private material." >&2
        echo "  (Not printed here -- printing it is the disclosure.)" >&2
        echo "" >&2
        echo "  Rename the ref and push that instead:" >&2
        echo "    git branch -m <new-name>" >&2
        echo "" >&2
        exit 1
    fi

    # Deleting a ref pushes nothing.
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac

    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        RANGE="$local_sha"            # new branch: every reachable commit
        # `git diff <sha>` compares the WORKTREE to that commit, not the
        # commit's own contents -- so the binary scan below saw nothing on
        # a new branch and reported clean. The empty tree is the correct
        # base for "everything this ref introduces".
        DIFFBASE="4b825dc642cb6eb9a060e54bf8d69288fbee4904"
    else
        RANGE="$remote_sha..$local_sha"
        DIFFBASE="$remote_sha"
    fi

    # BINARY BLOBS. Every content guard here scans text, and git renders a
    # binary as "Binary files differ" -- so the scan below, and the audit of
    # already-pushed history, both report it clean whatever is inside it.
    # No binary has ever been committed to this repo (verified across the
    # whole history), and that is the only reason those guards can be trusted
    # retroactively. This keeps it true.
    BINARIES="$(git diff --numstat "$DIFFBASE" "$local_sha" 2>/dev/null | awk '$1=="-" && $2=="-" {print $3}')"
    if [ -n "$BINARIES" ]; then
        echo "" >&2
        echo "  ################################################################" >&2
        echo "  #        PUSH BLOCKED: a binary file cannot be scanned         #" >&2
        echo "  ################################################################" >&2
        echo "" >&2
        printf '    %s\n' $BINARIES >&2
        echo "" >&2
        echo "  This repo is source code and documentation. Every privacy" >&2
        echo "  guard here reads text; git shows a binary as \"Binary files" >&2
        echo "  differ\", so nothing can see what is inside one." >&2
        echo "" >&2
        echo "  Build test fixtures at run time instead of committing them." >&2
        echo "" >&2
        exit 1
    fi

    # LISTED, not assumed. `git rev-list` exits 128 with empty stdout when
    # $remote_sha is not a local object -- a stale tracking ref, someone
    # else's force-push, a gc'd object, a shallow clone. stderr was
    # discarded and the status unread, so the loop ran zero times, FOUND
    # stayed 0, and the hook exited 0 having scanned nothing. Zero commits
    # scanned read exactly like zero commits matching.
    #
    # This file already fails closed on grep exit >= 2. This was the one
    # place it did not.
    COMMITS="$(git rev-list "$RANGE" 2>/dev/null)"
    if [ "$?" -ne 0 ]; then
        echo "" >&2
        echo "  ################################################################" >&2
        echo "  #      PUSH BLOCKED: could not list the commits to check       #" >&2
        echo "  ################################################################" >&2
        echo "" >&2
        echo "  git rev-list failed for $RANGE, so NOTHING was scanned." >&2
        echo "  Usually a stale remote-tracking ref: run \`git fetch\` and" >&2
        echo "  try again." >&2
        echo "" >&2
        exit 1
    fi

    for sha in $COMMITS; do
        # MESSAGE AND CONTENT. This read only `%B` until two real filenames
        # from a personal work archive were pushed inside a test fixture,
        # under the clean subject "use invented paths, not real archive
        # filenames" -- the commit that DELETED them. Nothing had anything to
        # match: the message was clean, and the working-tree test went green
        # the moment the file changed. The strings are still in the public
        # history, because a force-push makes an object unreachable, not
        # absent.
        #
        # A private name in a diff discloses exactly what one in a subject
        # line does. `-p` for the patch, `%B` for the message, one pass.
        git log -1 --format='%B' -p "$sha" | grep -qiEf "$ACTIVE"
        RC=$?
        if [ "$RC" -ge 2 ]; then
            echo "" >&2
            echo "  PUSH BLOCKED: the private-name scan errored on $sha," >&2
            echo "  so this history was NOT checked." >&2
            echo "" >&2
            exit 1
        fi
        if [ "$RC" -eq 0 ]; then
            if [ "$FOUND" -eq 0 ]; then
                echo "" >&2
                echo "  ################################################################" >&2
                echo "  #        PUSH BLOCKED: private name in a commit or a file      #" >&2
                echo "  ################################################################" >&2
                echo "" >&2
            fi
            # The SHA and date ONLY. The subject was printed here until a
            # test ran the hook and found the obvious: the reason this fired
            # is that the private name is IN the subject, so echoing it put
            # the string into exactly the terminal scrollback and CI logs
            # this hook exists to keep it out of. The SHA identifies the
            # commit unambiguously; `git show` it locally, where the string
            # already is.
            echo "    $(git log -1 --format='%h  %ad' --date=short "$sha")" >&2
            FOUND=1
        fi
    done
done

if [ "$FOUND" -ne 0 ]; then
    echo "" >&2
    echo "  The name is in the commit MESSAGE, in the DIFF, or both -- this" >&2
    echo "  scans all of it. Check locally with:" >&2
    echo "" >&2
    echo "    git log -1 -p <sha>" >&2
    echo "" >&2
    echo "  A message is fixed by rewording (git rebase -i, or amend). A" >&2
    echo "  name in a file is NOT: deleting it in a later commit leaves it" >&2
    echo "  in the history you are pushing. The diff has to go too." >&2
    echo "" >&2
    echo "  Do NOT push and fix afterwards. A force-push makes a commit" >&2
    echo "  UNREACHABLE, not absent: GitHub keeps serving it by SHA and only" >&2
    echo "  GitHub Support can purge it. This project lost two months to that." >&2
    echo "" >&2
    exit 1
fi
exit 0
